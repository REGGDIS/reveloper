# Entorno: development, testing o production
DJANGO_ENV=development

# Configuración de Django
DJANGO_SECRET_KEY=tu-clave-secreta-de-al-menos-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Seguridad HTTPS para producción
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Activar solo detrás de un proxy confiable que configure X-Forwarded-Proto
DJANGO_USE_X_FORWARDED_PROTO=False

# Configuración de Base de Datos MySQL
DB_NAME=reveloper
DB_USER=root
DB_PASSWORD=tu_contrasena_aqui
DB_HOST=localhost
DB_PORT=3306
